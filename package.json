{
  "name": "tbd-monorepo",
  "description": "GPU command graphs, chunked data, and compute modules for the web",
  "license": "MIT",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/visgl/tbd"
  },
  "keywords": [
    "webgl",
    "visualization",
    "animation",
    "3d"
  ],
  "workspaces": [
    "dev-modules/*",
    "modules/*",
    "examples/**/*",
    "website"
  ],
  "browser": {
    "fs": false
  },
  "scripts": {
    "build": "ocular-clean && (cd modules/constants && yarn pre-build) && ocular-build",
    "lint": "ocular-lint",
    "test": "yarn test-node && yarn test-headless",
    "test-node": "ocular-test node --no-coverage",
    "test-browser": "ocular-test browser --no-coverage",
    "test-headless": "ocular-test headless --no-coverage",
    "test-coverage": "ocular-test headless --coverage",
    "playwright:install": "playwright install chromium",
    "examples:typecheck": "node ./scripts/examples-typecheck.mjs",
    "website:build": "yarn workspace website-docusaurus build",
    "website:start": "yarn workspace website-docusaurus start"
  },
  "devDependencies": {
    "@babel/core": "^7.28.3",
    "@babel/preset-env": "^7.28.3",
    "@loaders.gl/core": "~5.0.0-alpha.5",
    "@loaders.gl/gltf": "~5.0.0-alpha.5",
    "@loaders.gl/las": "~5.0.0-alpha.5",
    "@loaders.gl/parquet": "~5.0.0-alpha.5",
    "@loaders.gl/polyfills": "~5.0.0-alpha.5",
    "@math.gl/crs": "5.0.0-alpha.5",
    "@math.gl/dggs-geohash": "^4.1.0",
    "@math.gl/dggs-quadkey": "^4.1.0",
    "@math.gl/dggs-s2": "^4.1.0",
    "@math.gl/proj4": "~5.0.0-alpha.5",
    "@probe.gl/bench": "^4.1.1",
    "@probe.gl/stats": "^4.1.1",
    "@probe.gl/stats-widget": "^4.1.1",
    "@probe.gl/test-utils": "^4.1.1",
    "@types/node": "22.15.2",
    "@vis.gl/dev-tools": "^2.0.0-beta.1",
    "@vis.gl/ts-plugins": "^2.0.0-beta.1",
    "@vitest/coverage-istanbul": "4.1.0",
    "a5-js": "^0.8.0",
    "esbuild": "^0.28.1",
    "h3-js": "^4.4.0",
    "playwright": "^1.58.0",
    "pngjs": "^7.0.0",
    "vitest": "^4.0.18",
    "wgsl_reflect": "1.2.3",
    "yaml": "^2.8.1"
  },
  "resolutions": {
    "@cmfcmf/docusaurus-search-local": "^2.0.1",
    "@docusaurus/plugin-client-redirects": "^3.10.2",
    "@docusaurus/plugin-content-docs": "^3.10.2",
    "@docusaurus/preset-classic": "^3.10.2",
    "cheerio": "1.0.0-rc.9",
    "@luma.gl/core": "workspace:*",
    "@luma.gl/engine": "workspace:*",
    "@luma.gl/shadertools": "workspace:*",
    "@luma.gl/webgl": "workspace:*",
    "@loaders.gl/schema-utils@npm:5.0.0-alpha.5": "patch:@loaders.gl/schema-utils@npm%3A5.0.0-alpha.5#./.yarn/patches/@loaders.gl-schema-utils-npm-5.0.0-alpha.5-b7b149a264.patch"
  },
  "packageExtensions": {
    "@loaders.gl/gltf@~5.0.0-alpha.5": {
      "peerDependencies": {
        "@loaders.gl/core": "~5.0.0-alpha.5"
      }
    },
    "@loaders.gl/images@~5.0.0-alpha.5": {
      "peerDependencies": {
        "@loaders.gl/core": "~5.0.0-alpha.5"
      }
    }
  },
  "dependencies": {
    "@deck.gl-community/panels": "https://github.com/visgl/deck.gl-community.git#workspace=@deck.gl-community/panels&commit=ede78777382aaf1c821a9c427cdb48eb4e77e20e",
    "@math.gl/types": "^4.1.0",
    "@types/offscreencanvas": "^2019.7.3",
    "preact": "^10.17.0"
  },
  "packageManager": "yarn@4.13.0+sha512.5c20ba010c99815433e5c8453112165e673f1c7948d8d2b267f4b5e52097538658388ebc9f9580656d9b75c5cc996f990f611f99304a2197d4c56d21eea370e7"
}
