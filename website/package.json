{
  "name": "website-docusaurus",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "start": "node ./scripts/sync-example-assets.mjs && yarn build:standalone-examples && docusaurus start",
    "build": "node ./scripts/sync-example-assets.mjs && yarn build:standalone-examples && docusaurus build",
    "serve": "docusaurus serve",
    "clear": "docusaurus clear",
    "build:standalone-examples": "yarn workspace luma.gl-examples-showcase-scene build:website"
  },
  "resolution_notes": {
    "cheerio": "@cmfcmf/docusaurus-search-local breaks with v1.0.0 production release"
  },
  "dependencies": {
    "@algolia/autocomplete-js": "^1.19.2",
    "@docusaurus/core": "^3.10.2",
    "@docusaurus/faster": "^3.10.2",
    "@probe.gl/stats": "^4.1.1",
    "@probe.gl/stats-widget": "^4.1.1",
    "@signalwire/docusaurus-plugin-llms-txt": "^1.2.2",
    "@stackblitz/sdk": "^1.11.0",
    "@vis.gl/docusaurus-website": "2.0.0-beta.1",
    "clsx": "^1.1.1",
    "maplibre-gl": "^5.13.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "zustand": "^4.1.5"
  },
  "devDependencies": {
    "@cmfcmf/docusaurus-search-local": "^2.0.0",
    "@docusaurus/tsconfig": "^3.10.2",
    "docusaurus-mdx-checker": "^3.0.0",
    "docusaurus-plugin-typedoc": "^1.4.2",
    "typedoc": "^0.28.19",
    "typedoc-plugin-markdown": "^4.10.0",
    "typescript": "6.0.3"
  },
  "browserslist": [
